{
  "name": "sendresponse",
  "version": "2.0.1",
  "description": "Promise-capable library for simple and consistent management of sending responses from a REST server",
  "main": "dist/sendresponse.js",
  "types": "dist/sendresponse.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js && tsc -p test/fixtures/tsconfig.json",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taxilian-promises/sendresponse.git"
  },
  "keywords": [
    "REST",
    "express",
    "node",
    "sendresponse"
  ],
  "author": "Richard Bateman <taxilian@gmail.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/taxilian-promises/sendresponse/issues"
  },
  "homepage": "https://github.com/taxilian-promises/sendresponse",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "express": ">= 4"
  }
}
